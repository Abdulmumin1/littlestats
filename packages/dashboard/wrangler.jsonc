{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "littlestats-analytics",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-10",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "littlestats-2",
      "database_id": "393725bd-d0fb-4c13-bc2e-c43d36601880",
      "migrations_dir": "./migrations",
    },
  ],

  "pipelines": [
    {
      "binding": "ANALYTICS_STREAM",
      "stream": "cbc09f827c5c473f82ff19c29a961e7f",
    },
  ],

  "vars": {
    "ANALYTICS_WRITE_MODE": "pipeline",
    "ANALYTICS_READ_MODE": "r2",
    "CLOUDFLARE_ACCOUNT_ID": "fa97301bcfdd3061f1dce2adc8289535",
    "R2_ANALYTICS_BUCKET": "littlestats-analytics-data",
    "R2_ANALYTICS_NAMESPACE": "analytics",
    "R2_ANALYTICS_TABLE": "events_v1",
  },

  "send_email": [
    {
      "name": "SEND_EMAIL",
    },
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "ANALYTICS_DO",
        "class_name": "DomainAnalyticsDO",
      },
    ],
  },

  "migrations": [
    {
      "tag": "v2",
      "new_classes": ["DomainAnalyticsDO"],
    },
  ],

  "routes": [
    {
      "pattern": "stats.littlestats.click",
      "custom_domain": true,
    },
  ],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
